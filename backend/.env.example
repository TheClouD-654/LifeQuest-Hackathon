# ============================================================
# LIFE RPG — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=production
PORT=5000

# Frontend URL (used for CORS and OAuth redirects)
# In development: http://localhost:3000
# In production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# ─── Cloud Database Connection ──────────────────────────────
# Works with any Cloud MySQL provider (Aiven, TiDB Cloud Serverless, Railway, PlanetScale, etc.)
# Example TiDB Serverless:
# DATABASE_URL="mysql://<USER>:<PASSWORD>@gateway01.<REGION>.prod.aws.tidbcloud.com:4000/life_rpg?sslaccept=strict"
# Example Aiven / Railway:
# DATABASE_URL="mysql://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?ssl-mode=REQUIRED"
# Example Local / Docker:
DATABASE_URL="mysql://root:your_password@localhost:3306/life_rpg"

# ─── Session Secret ──────────────────────────────────────────
# Generate a strong 32-char secret (e.g. openssl rand -hex 32)
SESSION_SECRET=life_rpg_super_secret_hackathon_session_key_2026

# ─── Google OAuth (Optional) ─────────────────────────────────
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
