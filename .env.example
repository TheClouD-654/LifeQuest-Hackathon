# ============================================================
# LIFE QUEST — Environment Variables
# Copy this file to backend/.env and fill in your values
# ============================================================

# Server
NODE_ENV=production
PORT=5000

# Frontend URL (used for CORS and OAuth redirects)
# In development: http://localhost:3000
# In production: https://lifequest-pzxa.onrender.com
FRONTEND_URL=https://lifequest-pzxa.onrender.com

# ─── Cloud Database Connection ──────────────────────────────
# Works with any Cloud MySQL provider (TiDB Cloud Serverless, Aiven, Railway, PlanetScale, etc.)
# Example TiDB Serverless:
# DATABASE_URL="mysql://<USER>:<PASSWORD>@gateway01.<REGION>.prod.aws.tidbcloud.com:4000/life_rpg?sslaccept=strict"
# Example Aiven / Railway:
# DATABASE_URL="mysql://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?ssl-mode=REQUIRED"
# Example Local / Docker:
DATABASE_URL="mysql://root:your_password@localhost:3306/life_rpg"

# ─── Session Secret ──────────────────────────────────────────
# Generate a strong 32-char secret (e.g. openssl rand -hex 32)
SESSION_SECRET=your_long_random_session_secret_here

# ─── Google OAuth (Optional) ─────────────────────────────────
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://lifequest-pzxa.onrender.com/api/auth/google/callback
